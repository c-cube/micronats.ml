(rule
 (targets calculator.ml calculator.mli)
 (deps calculator.proto)
 (enabled_if %{bin-available:ocaml-protoc})
 (action
  (run
   ocaml-protoc
   -I
   .
   --binary
   --yojson
   --services
   --ml_out
   .
   calculator.proto)))

(library
 (name calculator)
 (modules calculator)
 (enabled_if %{lib-available:pbrt_services})
 (libraries pbrt pbrt_services pbrt_yojson yojson))

(test
 (name test_rpc)
 (package micronats)
 (enabled_if %{lib-available:micronats.rpc})
 (libraries micronats micronats.rpc eio_posix calculator)
 (modules test_rpc))
